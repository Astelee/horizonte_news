rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ── Admins ────────────────────────────────────────────────────
    match /admins/{adminId} {
      // O próprio usuário pode checar se é admin (isOwner), e um
      // admin pode listar todos (usado pelo painel, em
      // Configurações → Administradores, para mostrar quem tem
      // acesso).
      allow read: if isOwner(adminId) || isAdmin();
      // Só admin adiciona/remove outro admin — pelo painel
      // (Configurações → Administradores). O primeiro admin do
      // projeto precisa ser criado manualmente pelo console do
      // Firebase (não existe "auto-promoção").
      allow write: if isAdmin();
    }

    // ── Configurações globais do app (manutenção, comentários) ────
    // Documento único (app_config/global), lido por todo mundo — o
    // app precisa saber se está em manutenção ou se comentários
    // estão desativados mesmo sem o usuário estar logado. Só admin
    // escreve (ver Configurações no painel).
    match /app_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── XP dos usuários ───────────────────────────────────────────
    match /users_xp/{userId} {
      allow read: if request.auth != null;

      // O dono pode criar seu próprio documento de XP, mas nunca com
      // photoUrl já definido — a foto de perfil só entra depois de
      // aprovada por um admin (ver avatarApprovals mais abaixo).
      //
      // Também não pode nascer já com XP/nível acima do inicial nem com
      // premiumTier/premiumExpiresAt. Isso importa porque o dono agora
      // pode APAGAR o próprio documento (exclusão de conta, mais
      // abaixo): sem esta trava, bastaria apagar e recriar o doc já
      // com premiumTier='ultra' e nível alto para burlar a regra de
      // update que protege esses campos. Os dois fluxos legítimos de
      // criação (register_screen e XpService._initializeUser) gravam
      // totalXp: 0 e level: 1 e nunca gravam premiumTier.
      allow create: if isOwner(userId) &&
        !('photoUrl' in request.resource.data) &&
        !('premiumTier' in request.resource.data) &&
        !('premiumExpiresAt' in request.resource.data) &&
        (!('totalXp' in request.resource.data) ||
          request.resource.data.totalXp == 0) &&
        (!('level' in request.resource.data) ||
          request.resource.data.level == 1);

      // O dono pode atualizar seus dados livremente, incluindo
      // REMOVER photoUrl (apagar a própria foto continua uma ação
      // instantânea, sem moderação) — mas nunca DEFINIR um valor
      // nesse campo: isso é exclusivo de admin, via aprovação da
      // fila de fotos pendentes (avatarApprovals). Sem essa
      // restrição, o usuário poderia escrever a foto direto aqui e
      // pular a fila de aprovação.
      //
      // premiumTier/premiumExpiresAt seguem a MESMA lógica: só admin
      // (ou, no futuro, a Cloud Function que valida a compra no
      // Google Play com o Admin SDK — que também passa por isAdmin())
      // pode escrever nesses campos. Sem essa trava, qualquer usuário
      // logado poderia se autoconceder Premium direto pelo app.
      allow update: if isAdmin() || (
        isOwner(userId) &&
        (!('photoUrl' in request.resource.data) ||
         !request.resource.data.diff(resource.data).affectedKeys()
           .hasAny(['photoUrl'])) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['premiumTier', 'premiumExpiresAt'])
      );

      // ── Exclusão da própria conta ────────────────────────────────
      // Sem esta regra, o usuário comum tomava "permissão negada" ao
      // apagar o próprio documento de XP durante a exclusão de conta
      // (Configurações → Excluir conta): o app apagava o perfil, falhava
      // aqui e deixava a conta pela metade. Só o DONO (ou um admin)
      // pode apagar este documento; ninguém apaga o de outra pessoa.
      allow delete: if isOwner(userId) || isAdmin();

      // ── XP ganho por curtida em comentário ───────────────────────
      // A curtida credita XP fixo (5) ao AUTOR do comentário curtido,
      // e quem escreve aqui é quem curtiu (não o dono do documento).
      // Por isso essa regra é bem mais estreita que a de cima: só
      // totalXp/level podem mudar, o delta é exatamente o valor fixo
      // de uma curtida (XpService.commentLikeXp), e nunca sobre o
      // próprio documento (sem auto-curtida).
      allow update: if request.auth != null &&
        request.auth.uid != userId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['totalXp', 'level']) &&
        request.resource.data.totalXp == resource.data.totalXp + 5;

      // ── Check-in diário ───────────────────────────────────────────
      // checkInToday()/recoverDay() (ver checkin_service.dart) gravam
      // dois lugares: os campos-resumo aqui no doc principal
      // (checkinStreak, lastCheckinDate etc.) e um documento por dia
      // na subcoleção checkins/{yyyy-MM-dd}. Sem uma regra própria
      // para a subcoleção, ela caía na regra "Demais coleções" do
      // fim do arquivo (allow write: if isAdmin()) — por isso só
      // administradores conseguiam fazer check-in; usuários comuns
      // eram bloqueados silenciosamente pela regra padrão.
      //
      // xpAwarded é validado contra os MESMOS valores hardcoded no
      // cliente (CheckinService.baseXp = 10 e os bônus de sequência
      // em bonusForStreak) para impedir que alguém edite o app e
      // grave um valor de XP maior do que o check-in realmente vale.
      // O streak em si (campo `checkinStreak` no doc pai) não dá pra
      // validar aqui com segurança sem duplicar toda a lógica de
      // sequência em regras — fica só a trava de valor de XP, que é
      // o que evita ganho arbitrário de pontos.
      function isValidCheckinXp(xp) {
        return xp == 10   // baseXp
            || xp == 40   // baseXp + bônus de 7 dias   (10+30)
            || xp == 70   // baseXp + bônus de 14 dias  (10+60)
            || xp == 160  // baseXp + bônus de 30 dias  (10+150)
            || xp == 310  // baseXp + bônus de 60 dias  (10+300)
            || xp == 510  // baseXp + bônus de 100 dias (10+500)
            || xp == 260  // baseXp + bônus de 150 dias (10+250)
            || xp == 410  // baseXp + bônus de 200 dias (10+400)
            || xp == 1010; // baseXp + bônus de 365 dias (10+1000)
      }

      match /checkins/{dateKey} {
        allow read: if isOwner(userId) || isAdmin();
        // create, não update: cada dia só é gravado uma vez (tanto
        // checkInToday quanto recoverDay checam existence antes e
        // nunca sobrescrevem um dia já registrado).
        allow create: if isOwner(userId)
            && request.resource.data.status in ['done', 'recovered']
            && isValidCheckinXp(request.resource.data.xpAwarded);
        allow update: if isAdmin();
        // O dono pode apagar os próprios check-ins: necessário para a
        // exclusão de conta (a subcoleção não some sozinha quando o
        // documento pai é apagado).
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // ── Perfis ────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId) || isAdmin();
    }

    // ── Suspensões (sistema de banimento usado pelo painel admin) ──
    match /suspensions/{userId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ── Banimento legado (usado hoje só na exclusão de conta) ──────
    match /banned_users/{userId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isOwner(userId);
    }

    // ── Nomes de usuário (reserva de username) ──────────────────────
    match /usernames/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
    }

    // ── Aprovação de fotos de perfil (moderação manual) ───────────
    // O usuário registra a foto recém-enviada (já hospedada no
    // Cloudinary) como pendente — ela NÃO vira pública sozinha; só
    // um admin, aprovando pelo painel, grava a URL em
    // users_xp/{uid}.photoUrl (ver a regra de users_xp acima, que
    // bloqueia o próprio usuário de definir esse campo).
    function validAvatarApprovalSubmit(uid) {
      return isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.status == 'pending'
          && request.resource.data.pendingPhotoUrl is string
          && request.resource.data.pendingPhotoUrl.size() > 0;
    }

    match /avatarApprovals/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if validAvatarApprovalSubmit(uid);
      // Reenvio: o próprio dono pode sobrescrever sua pendência
      // enquanto ela ainda não foi revisada (status era e continua
      // 'pending'). Depois de aprovada/rejeitada, só admin decide o
      // que acontece com o registro (ex.: uma nova submissão do
      // usuário deve criar um novo ciclo de revisão, não apagar
      // silenciosamente a decisão anterior).
      allow update: if isAdmin()
          || (validAvatarApprovalSubmit(uid) && resource.data.status == 'pending');
      allow delete: if isAdmin();
    }

    // ── Visualizações e compartilhamentos de posts ───────────────────
    match /post_views/{postId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /viewers/{userId} {
        allow read: if request.auth != null;
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    match /post_shares/{postId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Log ADM ───────────────────────────────────────────────────
    match /admin_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // ── Comentários ───────────────────────────────────────────────
    // Campos aceitos na criação de um comentário/resposta. username e
    // replyToUsername são opcionais (podem vir null), então só são
    // conferidos quando presentes.
    function validCommentCreate() {
      return request.auth != null
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 3
          && request.resource.data.text.size() <= 500
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.likesCount == 0;
    }

    // Único jeito de um não-admin "atualizar" um comentário/resposta:
    // mexer em exatamente likesCount OU repliesCount, em ±1, e nada
    // mais no documento. Isso cobre curtir/descurtir e o contador de
    // respostas, sem abrir brecha para editar texto ou trocar autor.
    function isCounterBump(field) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([field])
          && (request.resource.data[field] == resource.data[field] + 1
              || request.resource.data[field] == resource.data[field] - 1);
    }

    function validCommentCounterUpdate() {
      return request.auth != null
          && (isCounterBump('likesCount') || isCounterBump('repliesCount'));
    }

    // ── Edição do próprio texto (botão "Editar comentário") ─────────
    // Só o AUTOR do comentário (não admin — edição alheia continua
    // proibida mesmo para admin, que só pode excluir) pode alterar
    // exatamente os campos text/edited/editedAt, mantendo o mesmo
    // userId e sem tocar em likesCount/repliesCount/demais campos.
    // Isso garante que a edição nunca é usada como brecha para trocar
    // autoria ou zerar/inflar contadores.
    function validCommentTextEdit() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return request.auth != null
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && changed.hasOnly(['text', 'edited', 'editedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 3
          && request.resource.data.text.size() <= 500
          && request.resource.data.edited == true;
    }

    match /comments/{postId}/postComments/{commentId} {
      allow read: if true;
      allow create: if validCommentCreate();
      allow delete: if request.auth != null
          && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin()
          || validCommentCounterUpdate()
          || validCommentTextEdit();

      // ── Respostas (1 nível, estilo Instagram) ─────────────────────
      match /replies/{replyId} {
        allow read: if true;
        allow create: if validCommentCreate();
        allow delete: if request.auth != null
            && (resource.data.userId == request.auth.uid || isAdmin());
        allow update: if isAdmin()
            || validCommentCounterUpdate()
            || validCommentTextEdit();

        // ── Curtidas de uma resposta ─────────────────────────────────
        match /likes/{likerId} {
          allow read: if true;
          allow create: if isOwner(likerId);
          allow delete: if isOwner(likerId) || isAdmin();
          allow update: if false;
        }
      }

      // ── Curtidas de um comentário-raiz ───────────────────────────
      match /likes/{likerId} {
        allow read: if true;
        allow create: if isOwner(likerId);
        allow delete: if isOwner(likerId) || isAdmin();
        allow update: if false;
      }
    }

    // ── Central de notificações (respostas/curtidas em comentários) ──
    // Cada notificação pertence a UM destinatário (recipientUserId).
    // Só ele pode ler as próprias notificações, e só ele pode marcá-
    // las como lidas (update restrito ao campo `read`). A CRIAÇÃO é
    // feita pelo autor da AÇÃO (quem respondeu/curtiu, gravando o uid
    // dele em actorUserId) diretamente do app — não há Cloud Function
    // nesse projeto — então validamos aqui o suficiente para impedir
    // que alguém crie notificação em nome de outro usuário ou
    // falsificando o campo `read`/`type`.
    function validNotificationCreate() {
      return request.auth != null
          && request.resource.data.actorUserId == request.auth.uid
          && request.resource.data.actorUserId != request.resource.data.recipientUserId
          && request.resource.data.recipientUserId is string
          && request.resource.data.recipientUserId.size() > 0
          && request.resource.data.type in ['comment_reply', 'comment_like']
          && request.resource.data.read == false;
    }

    // Reabrir uma notificação de curtida já existente (curtir de novo
    // depois de descurtir) só pode mexer em `read`/`createdAt`, sem
    // trocar remetente/destinatário/tipo — mesma lógica de
    // isCounterBump acima, mas para os dois campos permitidos aqui.
    function validNotificationReopen() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return request.auth != null
          && request.auth.uid == resource.data.actorUserId
          && changed.hasOnly(['read', 'createdAt'])
          && request.resource.data.read == false;
    }

    function validNotificationMarkRead() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return request.auth != null
          && request.auth.uid == resource.data.recipientUserId
          && changed.hasOnly(['read'])
          && request.resource.data.read == true;
    }

    match /notifications/{notificationId} {
      allow read: if request.auth != null
          && resource.data.recipientUserId == request.auth.uid;
      allow create: if validNotificationCreate();
      allow update: if validNotificationMarkRead() || validNotificationReopen();
      // Só admin apaga notificações diretamente — o app não expõe
      // exclusão manual pelo usuário comum (ver GUIA_DA_IA: usuário
      // não pode criar/alterar notificações manualmente além do que
      // as regras acima autorizam).
      allow delete: if isAdmin();
    }

    // ── Presença (online/offline) ────────────────────────────────
    match /presence/{userId} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId);
    }

    // ── Solicitações de assinatura (aprovação manual PRO/ULTRA) ───
    // Depois que o Google Play Billing confirma a compra, o app cria
    // aqui um registro pendente (ver SubscriptionRequestService) em
    // vez de liberar o Premium sozinho. Só o próprio usuário pode
    // criar sua solicitação (sempre com status: 'pendente' e o uid
    // batendo com quem está autenticado), e só um admin pode
    // aprovar/recusar (mudar o status), evitando que o usuário
    // aprove a própria compra.
    function validSubscriptionRequestCreate() {
      return request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'pendente'
          && request.resource.data.plan in ['pro', 'ultra'];
    }

    match /subscriptionRequests/{requestId} {
      allow read: if isAdmin()
          || (request.auth != null &&
              resource.data.uid == request.auth.uid);
      allow create: if validSubscriptionRequestCreate();
      // Só admin pode mudar o status (aprovar/recusar) — o usuário
      // nunca pode alterar a própria solicitação depois de criada.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Demais coleções ───────────────────────────────────────────
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}