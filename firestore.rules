rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Suspensão/banimento ativo: o documento suspensions/{uid} existe e
    // (não tem prazo = permanente) ou o prazo (`until`) ainda não passou.
    // É a MESMA leitura que o app faz (CommentsSection._sendComment), agora
    // também imposta aqui — antes um app modificado ignorava a suspensão.
    function isSuspended(uid) {
      let p = /databases/$(database)/documents/suspensions/$(uid);
      return exists(p) &&
        (get(p).data.get('until', null) == null ||
         get(p).data.until > request.time);
    }

    // ── Admins ────────────────────────────────────────────────────
    match /admins/{adminId} {
      // O próprio usuário pode checar se é admin (isOwner), e um
      // admin pode listar todos (usado pelo painel, em
      // Configurações → Administradores, para mostrar quem tem
      // acesso).
      allow read: if isOwner(adminId) || isAdmin();
      // Só admin adiciona/remove outro admin — pelo painel
      // (Configurações → Administradores). O primeiro admin do
      // projeto precisa ser criado manualmente pelo console do
      // Firebase (não existe "auto-promoção").
      allow write: if isAdmin();
    }

    // ── Configurações globais do app (manutenção, comentários) ────
    // Documento único (app_config/global), lido por todo mundo — o
    // app precisa saber se está em manutenção ou se comentários
    // estão desativados mesmo sem o usuário estar logado. Só admin
    // escreve (ver Configurações no painel).
    match /app_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── XP dos usuários ───────────────────────────────────────────
    //
    // Limites de segurança do XP (espelham XpService):
    //  • totalXp só SOBE e no máximo +1000 por gravação (maior ganho
    //    legítimo de uma ação ≈ 480: comentário × ULTRA × evento);
    //  • `level` nunca pode ser maior que o nível que o totalXp permite
    //    (tabela = round(35 × (n-1)^2.15), a mesma de XpService.levelFromXp);
    //  • campos de premium e de "override" de admin só admin/backend escreve;
    //  • e-mail e data de nascimento NÃO ficam no perfil público
    //    (vão para users_private).
    //
    // LIMITE CONHECIDO: o XP é calculado no aparelho (não há servidor de
    // XP), então um app adulterado ainda consegue ganhar XP "no ritmo
    // máximo permitido por gravação". Impedir isso 100% exige creditar o
    // XP num backend (ver GUIA_DA_IA.md, seção 21).
    function xpLevelThresholds() {
      return [0, 35, 155, 371, 689, 1114, 1649, 2296, 3060, 3942, 4944, 6068,
              7317, 8691, 10192, 11821, 13581, 15472, 17495, 19651, 21942,
              24369, 26933, 29633, 32473, 35452, 38571, 41831, 45233, 48778];
    }

    // true se `lvl` é um nível que `xp` já permite (lvl <= nível calculado).
    function levelAllowedForXp(lvl, xp) {
      let t = xpLevelThresholds();
      return lvl is int && lvl >= 1 && lvl <= 30 && xp >= t[lvl - 1];
    }

    function xpProtectedKeys() {
      return ['uid', 'premiumTier', 'premiumExpiresAt', 'premiumTrial',
              'premiumSource', 'premiumPurchaseHash', 'adminOverrideActive',
              'adminOverrideLevel', 'adminOverrideTitleActive',
              'adminOverrideTitleLevel', 'adminBackupTotalXp'];
    }

    match /users_xp/{userId} {
      allow read: if request.auth != null;

      // O dono cria o próprio documento, nunca com foto, premium,
      // override de admin, dados pessoais, XP/nível acima do inicial.
      // (O dono pode APAGAR o documento — exclusão de conta —, então sem
      // estas travas bastaria apagar e recriar já "premium"/"nível 30".)
      allow create: if isOwner(userId) &&
        !('photoUrl' in request.resource.data) &&
        !('premiumTier' in request.resource.data) &&
        !('premiumExpiresAt' in request.resource.data) &&
        !('premiumTrial' in request.resource.data) &&
        !('premiumSource' in request.resource.data) &&
        !('premiumPurchaseHash' in request.resource.data) &&
        !('adminOverrideActive' in request.resource.data) &&
        !('adminOverrideLevel' in request.resource.data) &&
        !('adminOverrideTitleActive' in request.resource.data) &&
        !('adminOverrideTitleLevel' in request.resource.data) &&
        !('adminBackupTotalXp' in request.resource.data) &&
        !('email' in request.resource.data) &&
        !('birthDate' in request.resource.data) &&
        (!('totalXp' in request.resource.data) ||
          request.resource.data.totalXp == 0) &&
        (!('level' in request.resource.data) ||
          request.resource.data.level == 1) &&
        (!('totalSecondsOnline' in request.resource.data) ||
          request.resource.data.totalSecondsOnline == 0) &&
        (!('achievements' in request.resource.data) ||
          request.resource.data.achievements.hasOnly(['first_login']));

      function xpChangeOk(d, b) {
        let oldXp = b.get('totalXp', 0);
        return d.totalXp is int &&
          d.totalXp >= oldXp &&
          d.totalXp - oldXp <= 1000 &&
          (d.level == b.get('level', 1) ||
           levelAllowedForXp(d.level, d.totalXp));
      }

      function secondsChangeOk(d, b) {
        let oldSeconds = b.get('totalSecondsOnline', 0);
        return d.totalSecondsOnline is int &&
          d.totalSecondsOnline >= oldSeconds &&
          d.totalSecondsOnline - oldSeconds <= 10800;
      }

      function achievementsChangeOk(d, b) {
        return d.achievements is list &&
          d.achievements.size() <= 100 &&
          d.achievements.hasAll(b.get('achievements', []));
      }

      function checkinSummaryOk(d) {
        return (!('checkinStreak' in d) ||
                (d.checkinStreak is int && d.checkinStreak >= 0 &&
                 d.checkinStreak <= 31)) &&
               (!('longestCheckinStreak' in d) ||
                (d.longestCheckinStreak is int &&
                 d.longestCheckinStreak >= 0 &&
                 d.longestCheckinStreak <= 31));
      }

      // Tudo que o DONO pode alterar no próprio documento.
      function xpOwnerUpdateOk() {
        let d = request.resource.data;
        let b = resource.data;
        let changed = d.diff(b).affectedKeys();
        return
          // 1) campos exclusivos de admin / backend
          !changed.hasAny(xpProtectedKeys()) &&
          // 2) foto: o dono só REMOVE (definir é só via aprovação do admin)
          (!('photoUrl' in d) || !changed.hasAny(['photoUrl'])) &&
          // 3) dados pessoais: só apagar (migração para users_private)
          (!changed.hasAny(['email']) || !('email' in d)) &&
          (!changed.hasAny(['birthDate']) || !('birthDate' in d)) &&
          // 4) XP e nível
          (!changed.hasAny(['totalXp', 'level']) || xpChangeOk(d, b)) &&
          // 5) tempo online
          (!changed.hasAny(['totalSecondsOnline']) || secondsChangeOk(d, b)) &&
          // 6) conquistas só crescem
          (!changed.hasAny(['achievements']) || achievementsChangeOk(d, b)) &&
          // 7) resumo do check-in
          (!changed.hasAny(['checkinStreak', 'longestCheckinStreak']) ||
            checkinSummaryOk(d)) &&
          // 8) marca anti-spam de comentários (ver commentCooldownOk)
          (!changed.hasAny(['lastCommentAt']) || d.lastCommentAt == request.time);
      }

      allow update: if isAdmin() || (isOwner(userId) && xpOwnerUpdateOk());

      // Exclusão da própria conta (Configurações → Excluir conta).
      allow delete: if isOwner(userId) || isAdmin();

      // OBS: não existe mais regra para OUTRO usuário escrever aqui. O XP
      // de "curtida recebida" agora é creditado pelo backend (Cloudflare
      // Worker, rota /v1/xp/like) com trava de uma vez por curtida — a
      // regra antiga deixava qualquer logado somar +5 de XP e trocar o
      // nível de QUALQUER usuário, sem limite.

      // ── Check-in diário ───────────────────────────────────────────
      // Um documento por dia em checkins/{yyyy-MM-dd}. A data é validada
      // contra o RELÓGIO DO SERVIDOR (request.time, UTC), com folga de
      // ±1 dia para fusos horários:
      //  • 'done'      → hoje (±1 dia de fuso) — nunca data futura/inventada;
      //  • 'recovered' → dia já passado do mês atual (nunca hoje/futuro);
      // O ID do documento É a data, então cada dia só existe uma vez
      // (create, nunca update).
      //
      // xpAwarded espelha CheckinService.baseXp (10) e os bônus de
      // sequência (CheckinRewardsConfig.bonusForStreak).
      function isValidCheckinXp(xp) {
        return xp == 10   // baseXp
            || xp == 25   // baseXp + bônus de 3 dias   (10+15)
            || xp == 35   // baseXp + bônus de 5 dias   (10+25)
            || xp == 50   // baseXp + bônus de 7 dias   (10+40)
            || xp == 70   // baseXp + bônus de 10 dias  (10+60)
            || xp == 100  // baseXp + bônus de 14 dias  (10+90)
            || xp == 140  // baseXp + bônus de 18 dias  (10+130)
            || xp == 210  // baseXp + bônus de 24 dias  (10+200)
            || xp == 360; // baseXp + bônus de 31 dias  (10+350)
      }

      function checkinDay(dateKey) {
        let p = dateKey.split('-');
        return timestamp.date(int(p[0]), int(p[1]), int(p[2]));
      }

      function checkinServerDay() {
        return timestamp.date(request.time.year(), request.time.month(),
                              request.time.day());
      }

      function checkinDoneDateOk(dateKey) {
        return checkinDay(dateKey) >= checkinServerDay() - duration.value(1, 'd') &&
               checkinDay(dateKey) <= checkinServerDay() + duration.value(1, 'd');
      }

      function checkinRecoverDateOk(dateKey) {
        let ref = request.time - duration.value(1, 'd');
        return checkinDay(dateKey) >= timestamp.date(ref.year(), ref.month(), 1) &&
               checkinDay(dateKey) <= checkinServerDay();
      }

      function validCheckinCreate(dateKey) {
        let d = request.resource.data;
        return dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
          d.keys().hasOnly(['status', 'xpAwarded', 'timestamp']) &&
          d.timestamp == request.time &&
          ((d.status == 'done' && isValidCheckinXp(d.xpAwarded) &&
            checkinDoneDateOk(dateKey)) ||
           (d.status == 'recovered' && d.xpAwarded == 10 &&
            checkinRecoverDateOk(dateKey)));
      }

      match /checkins/{dateKey} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && validCheckinCreate(dateKey);
        allow update: if isAdmin();
        // O dono pode apagar os próprios check-ins: necessário para a
        // exclusão de conta (a subcoleção não some com o documento pai).
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // ── Dados pessoais (e-mail, data de nascimento) ───────────────
    // Ficam FORA de users_xp porque users_xp é legível por qualquer
    // usuário logado (ranking, perfis, comentários). Só o próprio dono e
    // administradores leem este documento.
    match /users_private/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
        request.resource.data.keys().hasOnly(['email', 'birthDate', 'updatedAt']) &&
        (!('email' in request.resource.data) ||
          request.resource.data.email == request.auth.token.email);
      allow update: if isAdmin() || (isOwner(userId) &&
        request.resource.data.keys().hasOnly(['email', 'birthDate', 'updatedAt']) &&
        (!('email' in request.resource.data) ||
          request.resource.data.email == request.auth.token.email));
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ── Perfis (coleção legada) ───────────────────────────────────
    // O app só APAGA este documento (exclusão de conta); não lê mais.
    // Deixou de ser legível por todos: pode ter dados pessoais antigos.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // ── Suspensões (sistema de banimento usado pelo painel admin) ──
    // Cada usuário lê só a PRÓPRIA suspensão (motivo/prazo); admin lê todas.
    match /suspensions/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // ── Banimento legado (usado hoje só na exclusão de conta) ──────
    match /banned_users/{userId} {
      allow read: if request.auth != null;
      // Só admin cria/edita um banimento. O dono mantém apenas o direito
      // de APAGAR o próprio registro (exclusão de conta). Antes, o dono
      // podia escrever qualquer coisa no próprio documento.
      allow create, update: if isAdmin();
      allow delete: if isAdmin() || isOwner(userId);
    }

    // ── Nomes de usuário (reserva de username) ──────────────────────
    match /usernames/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
    }

    // ── Aprovação de fotos de perfil (moderação manual) ───────────
    // O usuário registra a foto recém-enviada (já hospedada no
    // Cloudinary) como pendente — ela NÃO vira pública sozinha; só
    // um admin, aprovando pelo painel, grava a URL em
    // users_xp/{uid}.photoUrl (ver a regra de users_xp acima, que
    // bloqueia o próprio usuário de definir esse campo).
    function validAvatarApprovalSubmit(uid) {
      return isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.status == 'pending'
          && request.resource.data.pendingPhotoUrl is string
          && request.resource.data.pendingPhotoUrl.size() > 0;
    }

    match /avatarApprovals/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if validAvatarApprovalSubmit(uid);
      // Reenvio: o próprio dono pode sobrescrever sua solicitação enviando uma nova foto.
      // Permite reenviar mesmo que o status anterior fosse 'approved' ou 'rejected',
      // desde que a nova submissão seja válida (status 'pending', mesmo UID e photoUrl válida).
      allow update: if isAdmin()
          || validAvatarApprovalSubmit(uid);
      allow delete: if isAdmin();
    }

    // ── Visualizações e compartilhamentos de posts ───────────────────
    // Contadores públicos. Cada incremento precisa vir COM a prova no
    // mesmo batch (ver AdminViewsService.recordUniqueView e
    // XpService._recordPostShare):
    //  • views  → cria o documento viewers/{uid} (existe só uma vez por
    //    usuário e post: contagem única e exata, sem corrida);
    //  • shares → grava sharers/{uid} com lastSharedAt = agora, no máximo
    //    1 compartilhamento contado a cada 30 s por usuário e post.
    // Antes, qualquer usuário logado podia somar +1 quantas vezes quisesse.
    function viewerRegisteredNow(postId) {
      let v = /databases/$(database)/documents/post_views/$(postId)/viewers/$(request.auth.uid);
      return !exists(v) && existsAfter(v);
    }

    function shareRegisteredNow(postId) {
      let m = /databases/$(database)/documents/post_shares/$(postId)/sharers/$(request.auth.uid);
      return existsAfter(m) &&
        getAfter(m).data.lastSharedAt == request.time &&
        (!exists(m) ||
         get(m).data.lastSharedAt < request.time - duration.value(30, 's'));
    }

    match /post_views/{postId} {
      allow read: if true;
      allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(
              ['postId', 'postTitle', 'totalViews', 'uniqueViewers', 'lastViewedAt'])
          && request.resource.data.totalViews == 1
          && request.resource.data.uniqueViewers == 1
          && viewerRegisteredNow(postId);
      allow update: if isAdmin() || (
          request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['postId', 'postTitle', 'totalViews', 'uniqueViewers', 'lastViewedAt'])
          && request.resource.data.totalViews == resource.data.get('totalViews', 0) + 1
          && request.resource.data.uniqueViewers == resource.data.get('uniqueViewers', 0) + 1
          && viewerRegisteredNow(postId));
      allow delete: if isAdmin();

      // O documento do leitor guarda o e-mail dele (usado pelo painel):
      // só o próprio leitor e administradores podem ler.
      match /viewers/{userId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
            && request.resource.data.keys().hasOnly(
                ['userId', 'userName', 'userEmail', 'postId', 'postTitle',
                 'firstViewedAt', 'lastViewedAt'])
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.firstViewedAt == request.time
            && request.resource.data.lastViewedAt == request.time;
        // Revisita: só muda lastViewedAt (não conta de novo).
        allow update: if isAdmin() || (isOwner(userId)
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['lastViewedAt'])
            && request.resource.data.lastViewedAt == request.time);
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /post_shares/{postId} {
      allow read: if true;
      allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(
              ['postId', 'postTitle', 'totalShares', 'lastSharedAt'])
          && request.resource.data.totalShares == 1
          && shareRegisteredNow(postId);
      allow update: if isAdmin() || (
          request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['postId', 'postTitle', 'totalShares', 'lastSharedAt'])
          && request.resource.data.totalShares == resource.data.get('totalShares', 0) + 1
          && shareRegisteredNow(postId));
      allow delete: if isAdmin();

      match /sharers/{userId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
            && request.resource.data.keys().hasOnly(['userId', 'lastSharedAt'])
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.lastSharedAt == request.time;
        allow update: if isAdmin() || (isOwner(userId)
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['lastSharedAt'])
            && request.resource.data.lastSharedAt == request.time);
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // ── Log ADM ───────────────────────────────────────────────────
    match /admin_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // ── Comentários ───────────────────────────────────────────────
    // Campos aceitos na criação de um comentário/resposta.
    function commentFieldsOk() {
      return request.resource.data.keys().hasOnly([
        'userId', 'userName', 'username', 'text', 'createdAt', 'userLevel',
        'userAchievements', 'userAvatarId', 'userPhotoUrl',
        'userEquippedPremiumAvatarId', 'userEquippedPetId', 'likesCount',
        'repliesCount', 'replyToUsername']);
    }

    // Nível e conquistas exibidos junto do comentário precisam bater com o
    // que o autor realmente tem (antes dava para "publicar" como nível 30).
    function commentIdentityOk() {
      let u = get(/databases/$(database)/documents/users_xp/$(request.auth.uid)).data;
      let d = request.resource.data;
      return d.userLevel is int && d.userLevel >= 1 && d.userLevel <= 30 &&
        (d.userLevel <= u.get('level', 1) ||
         levelAllowedForXp(d.userLevel, u.get('totalXp', 0))) &&
        d.userAchievements is list &&
        d.userAchievements.hasOnly(u.get('achievements', []));
    }

    // Anti-spam e anti-duplicata: cada comentário/resposta precisa vir no
    // mesmo batch que grava users_xp/{uid}.lastCommentAt = agora, e só é
    // aceito se o anterior foi há mais de 10 segundos. Um duplo toque no
    // botão "enviar" gera dois batches — o segundo é recusado.
    function commentCooldownOk() {
      let u = /databases/$(database)/documents/users_xp/$(request.auth.uid);
      return existsAfter(u) &&
        getAfter(u).data.get('lastCommentAt', null) == request.time &&
        (!('lastCommentAt' in get(u).data) ||
         get(u).data.lastCommentAt < request.time - duration.value(10, 's'));
    }

    function validCommentBase() {
      let d = request.resource.data;
      return request.auth != null &&
        !isSuspended(request.auth.uid) &&
        commentFieldsOk() &&
        d.userId == request.auth.uid &&
        d.text is string &&
        d.text.size() >= 1 &&
        d.text.size() <= 10000 &&
        d.likesCount == 0 &&
        d.createdAt == request.time &&
        commentIdentityOk() &&
        commentCooldownOk();
    }

    function validCommentCreate() {
      return validCommentBase() &&
        request.resource.data.get('repliesCount', 0) == 0 &&
        !('replyToUsername' in request.resource.data);
    }

    function validReplyCreate() {
      return validCommentBase() &&
        !('repliesCount' in request.resource.data);
    }

    // likesCount só muda ±1 JUNTO com a criação/remoção da curtida do
    // PRÓPRIO usuário (documento likes/{uid} no mesmo batch/transação).
    function likesCountBumpOk(likePath) {
      let d = request.resource.data;
      let b = resource.data;
      return d.diff(b).affectedKeys().hasOnly(['likesCount']) &&
        ((d.likesCount == b.likesCount + 1 &&
          !exists(likePath) && existsAfter(likePath)) ||
         (d.likesCount == b.likesCount - 1 &&
          exists(likePath) && !existsAfter(likePath)));
    }

    // repliesCount só muda ±1 JUNTO com a criação/remoção da resposta
    // apontada por lastReplyId (mesmo batch). +1 exige que a resposta
    // nova seja do próprio usuário.
    // (O caminho da resposta só é montado dentro de replyBumpMatches,
    // depois de conferir que lastReplyId existe — assim uma edição de
    // texto, sem esse campo, nunca avalia uma expressão com erro.)
    function replyBumpMatches(postId, commentId, d, b) {
      let replyPath = /databases/$(database)/documents/comments/$(postId)/postComments/$(commentId)/replies/$(d.lastReplyId);
      return (d.repliesCount == b.repliesCount + 1 &&
              !exists(replyPath) && existsAfter(replyPath) &&
              getAfter(replyPath).data.userId == request.auth.uid) ||
             (d.repliesCount == b.repliesCount - 1 &&
              exists(replyPath) && !existsAfter(replyPath));
    }

    function repliesCountBumpOk(postId, commentId) {
      let d = request.resource.data;
      let b = resource.data;
      return request.auth != null &&
        d.diff(b).affectedKeys().hasOnly(['repliesCount', 'lastReplyId']) &&
        d.keys().hasAll(['repliesCount', 'lastReplyId']) &&
        d.lastReplyId is string &&
        replyBumpMatches(postId, commentId, d, b);
    }

    // ── Edição do próprio texto (botão "Editar comentário") ─────────
    // Só o AUTOR (nem admin edita texto alheio) altera exatamente
    // text/edited/editedAt; suspenso/banido não edita.
    function validCommentTextEdit() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return request.auth != null
          && !isSuspended(request.auth.uid)
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && changed.hasOnly(['text', 'edited', 'editedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 10000
          && request.resource.data.edited == true;
    }

    function validLikeCreate(likerId) {
      return isOwner(likerId) &&
        request.resource.data.keys().hasOnly(['likerUid', 'createdAt']) &&
        request.resource.data.likerUid == request.auth.uid &&
        request.resource.data.createdAt == request.time;
    }

    match /comments/{postId}/postComments/{commentId} {
      allow read: if true;
      allow create: if validCommentCreate();
      allow delete: if request.auth != null
          && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin()
          || likesCountBumpOk(/databases/$(database)/documents/comments/$(postId)/postComments/$(commentId)/likes/$(request.auth.uid))
          || repliesCountBumpOk(postId, commentId)
          || validCommentTextEdit();

      // ── Respostas (1 nível, estilo Instagram) ─────────────────────
      match /replies/{replyId} {
        allow read: if true;
        allow create: if validReplyCreate();
        allow delete: if request.auth != null
            && (resource.data.userId == request.auth.uid || isAdmin());
        allow update: if isAdmin()
            || likesCountBumpOk(/databases/$(database)/documents/comments/$(postId)/postComments/$(commentId)/replies/$(replyId)/likes/$(request.auth.uid))
            || validCommentTextEdit();

        // ── Curtidas de uma resposta ─────────────────────────────────
        match /likes/{likerId} {
          allow read: if true;
          allow create: if validLikeCreate(likerId);
          allow delete: if isOwner(likerId) || isAdmin();
          allow update: if false;
        }
      }

      // ── Curtidas de um comentário-raiz ───────────────────────────
      match /likes/{likerId} {
        allow read: if true;
        allow create: if validLikeCreate(likerId);
        allow delete: if isOwner(likerId) || isAdmin();
        allow update: if false;
      }
    }

    // ── Central de notificações (respostas/curtidas em comentários) ──
    // Cada notificação pertence a UM destinatário (recipientUserId). Só
    // ele lê e marca como lida. A CRIAÇÃO é feita por quem fez a ação
    // (actorUserId) direto do app e agora precisa estar AMARRADA a um
    // fato real e único:
    //  • comment_like  → id = like_{post}_{comentário}_{ator} e o
    //    documento de curtida do ator existe;
    //  • comment_reply → id = reply_{post}_{resposta} e a resposta existe e
    //    é do ator.
    // Sem isso qualquer usuário podia criar notificações em massa para
    // outra pessoa (spam).
    function rootLikeNotificationOk(notificationId, d) {
      return (!('replyId' in d) || d.replyId == null) &&
        notificationId == 'like_' + d.postId + '_' + d.commentId + '_' + request.auth.uid &&
        exists(/databases/$(database)/documents/comments/$(d.postId)/postComments/$(d.commentId)/likes/$(request.auth.uid));
    }

    function replyLikeNotificationOk(notificationId, d) {
      return ('replyId' in d) && d.replyId is string &&
        notificationId == 'like_' + d.postId + '_' + d.replyId + '_' + request.auth.uid &&
        exists(/databases/$(database)/documents/comments/$(d.postId)/postComments/$(d.commentId)/replies/$(d.replyId)/likes/$(request.auth.uid));
    }

    function replyNotificationOk(notificationId, d) {
      let p = /databases/$(database)/documents/comments/$(d.postId)/postComments/$(d.commentId)/replies/$(d.replyId);
      return d.replyId is string &&
        notificationId == 'reply_' + d.postId + '_' + d.replyId &&
        exists(p) &&
        get(p).data.userId == request.auth.uid;
    }

    function notificationTargetOk(notificationId) {
      let d = request.resource.data;
      return (d.type == 'comment_like' &&
              (rootLikeNotificationOk(notificationId, d) ||
               replyLikeNotificationOk(notificationId, d))) ||
             (d.type == 'comment_reply' &&
              replyNotificationOk(notificationId, d));
    }

    function validNotificationCreate(notificationId) {
      return request.auth != null
          && request.resource.data.actorUserId == request.auth.uid
          && request.resource.data.actorUserId != request.resource.data.recipientUserId
          && request.resource.data.recipientUserId is string
          && request.resource.data.recipientUserId.size() > 0
          && request.resource.data.type in ['comment_reply', 'comment_like']
          && request.resource.data.read == false
          && request.resource.data.postId is string
          && request.resource.data.commentId is string
          && notificationTargetOk(notificationId);
    }

    // Reabrir uma notificação de curtida já existente (curtir de novo
    // depois de descurtir) só pode mexer em `read`/`createdAt`.
    function validNotificationReopen() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return request.auth != null
          && request.auth.uid == resource.data.actorUserId
          && changed.hasOnly(['read', 'createdAt'])
          && request.resource.data.read == false;
    }

    function validNotificationMarkRead() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return request.auth != null
          && request.auth.uid == resource.data.recipientUserId
          && changed.hasOnly(['read'])
          && request.resource.data.read == true;
    }

    match /notifications/{notificationId} {
      allow read: if request.auth != null
          && resource.data.recipientUserId == request.auth.uid;
      allow create: if validNotificationCreate(notificationId);
      allow update: if validNotificationMarkRead() || validNotificationReopen();
      // Só admin apaga notificações diretamente.
      allow delete: if isAdmin();
    }

    // ── Presença (online/offline) ────────────────────────────────
    match /presence/{userId} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId);
    }

    // ── Solicitações de assinatura (aprovação manual PRO/ULTRA) ───
    // Fluxo manual, usado enquanto o backend de validação do Google Play
    // (Cloudflare Worker, /v1/billing/verify) não está configurado.
    // Depois que o Google Play Billing confirma a compra, o app cria aqui
    // um registro PENDENTE; só um admin aprova/recusa. O usuário nunca
    // altera a própria solicitação. Com o backend ligado, o app não cria
    // mais solicitações — o Premium é liberado pelo Worker depois de
    // consultar o Google Play.
    function validSubscriptionRequestCreate() {
      let d = request.resource.data;
      return request.auth != null
          && d.keys().hasOnly(['uid', 'userName', 'userEmail', 'plan',
                               'productId', 'requestedAt', 'status'])
          && d.uid == request.auth.uid
          && d.status == 'pendente'
          && d.requestedAt == request.time
          && ((d.plan == 'pro' && d.productId == 'premium_pro_mensal')
              || (d.plan == 'ultra' && d.productId == 'premium_ultra_mensal'));
    }

    match /subscriptionRequests/{requestId} {
      allow read: if isAdmin()
          || (request.auth != null &&
              resource.data.uid == request.auth.uid);
      allow create: if validSubscriptionRequestCreate();
      // Só admin pode mudar o status (aprovar/recusar).
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Atendimento privado (usuário ↔ equipe Horizonte News) ──────
    //
    // Estrutura:
    //   support_conversations/{uid}            ← ID = UID do usuário
    //   support_conversations/{uid}/messages/{messageId}
    //   support_config/public                  ← boas-vindas, horário
    //   support_config/agents                  ← quem atende / quem recebe push
    //   support_quick_replies/{id}             ← respostas rápidas
    //
    // Sem Cloud Functions (plano gratuito): quem envia grava a mensagem
    // E o resumo da conversa no MESMO batch. As regras abaixo exigem
    // que os dois cheguem juntos (existsAfter/getAfter), com timestamps
    // do servidor, contador +1 e remetente igual ao usuário autenticado.

    // Atendente = admin listado em support_config/agents. Se esse
    // documento ainda não existe, todo admin pode atender (modo
    // inicial). As regras não conseguem conferir cada UID da lista
    // contra /admins, mas isso não abre brecha: o atendente SEMPRE
    // precisa passar por isAdmin() também.
    function isSupportAgent() {
      return isAdmin() && (
        !exists(/databases/$(database)/documents/support_config/agents) ||
        request.auth.uid in get(/databases/$(database)/documents/support_config/agents)
            .data.get('agentUids', [])
      );
    }

    function supportConvPath(convId) {
      return /databases/$(database)/documents/support_conversations/$(convId);
    }

    function supportMsgPathAfter(convId, msgId) {
      return /databases/$(database)/documents/support_conversations/$(convId)/messages/$(msgId);
    }

    function validSupportProfile(d) {
      return d.userName is string && d.userName.size() <= 80
          && d.username is string && d.username.size() <= 40
          && d.usernameLower is string && d.usernameLower.size() <= 40
          && d.searchName is string && d.searchName.size() <= 80
          && (d.photoUrl == null || (d.photoUrl is string && d.photoUrl.size() <= 600));
    }

    function validSupportCategory(d) {
      return !('category' in d) || d.category == null
          || d.category in ['app', 'tecnico', 'assinatura', 'informacao', 'anunciar'];
    }

    function validSupportPreview(d) {
      return d.lastMessageText is string
          && d.lastMessageText.size() >= 1
          && d.lastMessageText.size() <= 200
          && d.lastMessageAt == request.time
          && d.lastActivityAt == request.time
          && d.lastMessageId is string
          && d.lastMessageId.size() >= 1
          && d.lastMessageId.size() <= 40;
    }

    // Resumo gravado por uma mensagem DO USUÁRIO.
    function validUserSummary(convId, d) {
      return validSupportPreview(d)
          && d.lastMessageSenderRole == 'user'
          && d.lastUserSendAt == request.time
          && d.awaitingReply == true
          && d.status == 'open'
          && validSupportCategory(d)
          && existsAfter(supportMsgPathAfter(convId, d.lastMessageId))
          && getAfter(supportMsgPathAfter(convId, d.lastMessageId)).data.senderId == request.auth.uid
          && getAfter(supportMsgPathAfter(convId, d.lastMessageId)).data.senderRole == 'user';
    }

    // Resumo gravado por uma mensagem DO ATENDENTE.
    function validAgentSummary(convId, d) {
      return validSupportPreview(d)
          && d.lastMessageSenderRole == 'agent'
          && d.lastAgentId == request.auth.uid
          && d.awaitingReply == false
          && d.status in ['open', 'resolved']
          && existsAfter(supportMsgPathAfter(convId, d.lastMessageId))
          && getAfter(supportMsgPathAfter(convId, d.lastMessageId)).data.senderId == request.auth.uid
          && getAfter(supportMsgPathAfter(convId, d.lastMessageId)).data.senderRole == 'agent';
    }

    function validUserConvCreate(convId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
            'userId', 'userName', 'username', 'usernameLower', 'searchName',
            'photoUrl', 'category', 'hidePreview', 'status', 'pinned', 'blocked',
            'awaitingReply', 'unreadUser', 'unreadAgent', 'lastMessageText',
            'lastMessageSenderRole', 'lastMessageAt', 'lastMessageId',
            'lastActivityAt', 'lastUserSendAt', 'createdAt'])
          && d.userId == convId
          && (!('hidePreview' in d) || d.hidePreview is bool)
          && validSupportProfile(d)
          && d.pinned == false
          && d.blocked == false
          && d.unreadUser == 0
          && d.unreadAgent == 1
          && d.createdAt == request.time
          && validUserSummary(convId, d);
    }

    function validAgentConvCreate(convId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
            'userId', 'userName', 'username', 'usernameLower', 'searchName',
            'photoUrl', 'category', 'status', 'pinned', 'blocked',
            'awaitingReply', 'unreadUser', 'unreadAgent', 'lastMessageText',
            'lastMessageSenderRole', 'lastMessageAt', 'lastMessageId',
            'lastActivityAt', 'lastAgentId', 'createdAt'])
          && d.userId == convId
          && validSupportProfile(d)
          && d.pinned == false
          && d.blocked == false
          && d.unreadUser == 1
          && d.unreadAgent == 0
          && d.createdAt == request.time
          && validAgentSummary(convId, d);
    }

    // Usuário envia mensagem (resumo + contador do atendente +1 +
    // intervalo mínimo de 2 s entre envios + conta não bloqueada).
    function validUserSend(convId) {
      let d = request.resource.data;
      let b = resource.data;
      return d.diff(b).affectedKeys().hasOnly([
            'userName', 'username', 'usernameLower', 'searchName', 'photoUrl',
            'category', 'hidePreview', 'status', 'awaitingReply', 'unreadAgent',
            'lastMessageText', 'lastMessageSenderRole', 'lastMessageAt',
            'lastMessageId', 'lastActivityAt', 'lastUserSendAt'])
          && d.userId == b.userId
          && (!('hidePreview' in d) || d.hidePreview is bool)
          && b.get('blocked', false) == false
          && validSupportProfile(d)
          && validUserSummary(convId, d)
          && d.unreadAgent == b.get('unreadAgent', 0) + 1
          && (!('lastUserSendAt' in b)
              || request.time > b.lastUserSendAt + duration.value(2, 's'));
    }

    function validUserReadMark() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(['unreadUser', 'userReadAt'])
          && d.unreadUser == 0
          && d.userReadAt == request.time;
    }

    // "Limpar conversa" (só para mim): o usuário esconde o histórico
    // anterior no próprio app. Nada é apagado do banco; a equipe
    // continua vendo tudo.
    function validUserClear() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(['userClearedAt', 'unreadUser'])
          && d.userClearedAt == request.time
          && d.unreadUser == 0;
    }

    function validUserPrefs() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(['hidePreview'])
          && d.hidePreview is bool;
    }

    function validAgentSend(convId) {
      let d = request.resource.data;
      let b = resource.data;
      return d.diff(b).affectedKeys().hasOnly([
            'lastMessageText', 'lastMessageSenderRole', 'lastMessageAt',
            'lastMessageId', 'lastActivityAt', 'lastAgentId', 'unreadUser',
            'awaitingReply', 'status'])
          && d.userId == b.userId
          && validAgentSummary(convId, d)
          && d.unreadUser == b.get('unreadUser', 0) + 1;
    }

    function validAgentReadMark() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(['unreadAgent', 'agentReadAt'])
          && d.unreadAgent == 0
          && d.agentReadAt == request.time;
    }

    // Resolver, reabrir, fixar, bloquear envio e categoria. Bloquear o
    // atendimento NÃO é banir a conta (suspensions/banned_users).
    function validAgentManage() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'pinned', 'blocked', 'awaitingReply', 'category'])
          && d.status in ['open', 'resolved']
          && d.pinned is bool
          && d.blocked is bool
          && d.awaitingReply is bool
          && (d.status != 'resolved' || d.awaitingReply == false)
          && validSupportCategory(d);
    }

    // "Excluir só para mim" do atendente: tira a conversa da caixa de
    // entrada e esconde o histórico anterior para a equipe. O usuário
    // continua vendo a conversa; se ele escrever de novo, ela volta
    // (a mensagem dele grava status 'open').
    function validAgentArchive() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'awaitingReply', 'unreadAgent', 'pinned', 'agentClearedAt'])
          && d.status == 'archived'
          && d.awaitingReply == false
          && d.unreadAgent == 0
          && d.pinned == false
          && d.agentClearedAt == request.time;
    }

    function validSupportMessage(convId, msgId) {
      let d = request.resource.data;
      return request.auth != null
          && msgId.size() <= 40
          && d.keys().hasOnly(['senderId', 'senderRole', 'text', 'createdAt', 'replyTo'])
          && d.senderId == request.auth.uid
          && d.text is string
          && d.text.size() >= 1
          && d.text.size() <= 2000
          && d.createdAt == request.time
          && (!('replyTo' in d) || d.replyTo == null || (
                d.replyTo is map
                && d.replyTo.keys().hasOnly(['id', 'text', 'senderRole'])
                && d.replyTo.id is string
                && d.replyTo.text is string
                && d.replyTo.text.size() <= 200
                && d.replyTo.senderRole in ['user', 'agent']))
          && getAfter(supportConvPath(convId)).data.lastMessageId == msgId
          && getAfter(supportConvPath(convId)).data.lastMessageAt == request.time
          && (
            (d.senderRole == 'user'
              && request.auth.uid == convId
              && !(exists(supportConvPath(convId))
                   && get(supportConvPath(convId)).data.get('blocked', false) == true))
            ||
            (d.senderRole == 'agent' && isSupportAgent())
          );
    }

    match /support_conversations/{convId} {
      allow read: if isOwner(convId) || isSupportAgent();

      allow create: if (isOwner(convId) && validUserConvCreate(convId))
          || (isSupportAgent() && validAgentConvCreate(convId));

      allow update: if (isOwner(convId) && (
              validUserSend(convId) || validUserReadMark() || validUserPrefs()
              || validUserClear()))
          || (isSupportAgent() && (
              validAgentSend(convId) || validAgentReadMark() || validAgentManage()
              || validAgentArchive()));

      // "Excluir para os dois": só atendente apaga a conversa de vez.
      allow delete: if isSupportAgent();

      match /messages/{msgId} {
        allow read: if isOwner(convId) || isSupportAgent();
        allow create: if validSupportMessage(convId, msgId);
        // Mensagens são imutáveis: ninguém edita depois de enviada
        // (evita adulterar o histórico). Só o atendente apaga, e é o que
        // "Excluir para os dois" usa.
        allow update: if false;
        allow delete: if isSupportAgent();
      }
    }

    // Textos públicos do atendimento (boas-vindas, horário). Qualquer
    // usuário logado lê; só atendente escreve.
    match /support_config/public {
      allow read: if request.auth != null;
      allow write: if isSupportAgent()
          && request.resource.data.keys().hasOnly(
              ['enabled', 'welcomeMessage', 'offHoursMessage', 'hours',
               'hidePreviewAgent', 'updatedAt'])
          && request.resource.data.welcomeMessage is string
          && request.resource.data.welcomeMessage.size() <= 500
          && request.resource.data.offHoursMessage is string
          && request.resource.data.offHoursMessage.size() <= 500;
    }

    // Quem atende e quem recebe push. Só admins leem. Quem escreve
    // precisa continuar na lista (ninguém se remove sem querer) e a
    // lista tem tamanho limitado.
    match /support_config/agents {
      allow read: if isAdmin();
      allow write: if isAdmin()
          && (!exists(/databases/$(database)/documents/support_config/agents)
              || request.auth.uid in get(/databases/$(database)/documents/support_config/agents)
                  .data.get('agentUids', []))
          && request.resource.data.keys().hasOnly(
              ['agentUids', 'notifyUids', 'updatedAt'])
          && request.resource.data.agentUids is list
          && request.resource.data.agentUids.size() >= 1
          && request.resource.data.agentUids.size() <= 10
          && request.auth.uid in request.resource.data.agentUids
          && request.resource.data.notifyUids is list
          && request.resource.data.notifyUids.size() <= 10;
    }

    match /support_quick_replies/{replyId} {
      allow read: if isSupportAgent();
      allow create, update: if isSupportAgent()
          && request.resource.data.keys().hasOnly(['title', 'text', 'order', 'updatedAt'])
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 1
          && request.resource.data.title.size() <= 40
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000;
      allow delete: if isSupportAgent();
    }

    // ── Coleções públicas que antes dependiam do "match tudo" ───────
    // Notícias: leitura pública (inclusive sem login), escrita só admin.
    match /noticias/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Documento-pai de comentários (comments/{postId}): o app lista essa
    // coleção na exclusão de conta e no painel ADM.
    match /comments/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Consultas de grupo (painel ADM → aba Comentários).
    match /{path=**}/postComments/{commentId} {
      allow read: if true;
    }
    match /{path=**}/replies/{replyId} {
      allow read: if true;
    }

    // ── Negação padrão ──────────────────────────────────────────────
    // Antes: match /{document=**} { allow read: if true; allow write:
    // if isAdmin(); } — deixava QUALQUER coleção sem regra legível por
    // qualquer pessoa, até sem login. Agora o que não tem regra
    // explícita é negado para todos (inclusive admin pelo app; o
    // Admin SDK/console não passam pelas regras).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}