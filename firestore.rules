// ── XP dos usuários ───────────────────────────────────────────
    match /users_xp/{userId} {
      allow read: if request.auth != null;

      // O dono pode criar seu próprio documento de XP, mas nunca com
      // photoUrl já definido — a foto de perfil só entra depois de
      // aprovada por um admin (ver avatarApprovals mais abaixo).
      allow create: if isOwner(userId) &&
        !('photoUrl' in request.resource.data);

      // O dono pode atualizar seus dados livremente, incluindo
      // REMOVER photoUrl (apagar a própria foto continua uma ação
      // instantânea, sem moderação) — mas nunca DEFINIR um valor
      // nesse campo: isso é exclusivo de admin, via aprovação da
      // fila de fotos pendentes (avatarApprovals). Sem essa
      // restrição, o usuário poderia escrever a foto direto aqui e
      // pular a fila de aprovação.
      allow update: if isAdmin() || (
        isOwner(userId) &&
        (!('photoUrl' in request.resource.data) ||
         !request.resource.data.diff(resource.data).affectedKeys()
           .hasAny(['photoUrl']))
      );

      // ── XP ganho por curtida em comentário ───────────────────────
      // A curtida credita XP fixo (5) ao AUTOR do comentário curtido,
      // e quem escreve aqui é quem curtiu (não o dono do documento).
      // Por isso essa regra é bem mais estreita que a de cima: só
      // totalXp/level podem mudar, o delta é exatamente o valor fixo
      // de uma curtida (XpService.commentLikeXp), e nunca sobre o
      // próprio documento (sem auto-curtida).
      allow update: if request.auth != null &&
        request.auth.uid != userId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['totalXp', 'level']) &&
        request.resource.data.totalXp == resource.data.totalXp + 5;

      // ── CHECK-IN DIÁRIO ───────────────────────────────────────────
      // Constantes espelhadas de CheckinService (checkin_service.dart)
      // — se os valores de XP mudarem lá, precisam mudar aqui também.
      function checkinBaseXp() { return 10; }

      function checkinBonusForStreak(streak) {
        return streak == 7   ? 30  :
               streak == 14  ? 60  :
               streak == 30  ? 150 :
               streak == 60  ? 300 :
               streak == 100 ? 500 : 0;
      }

      // 'today' no fuso do SERVIDOR (request.time), nunca calculado a
      // partir de um valor enviado pelo cliente — isso é o que
      // impede alguém de manipular o relógio do aparelho para burlar
      // o check-in diário.
      //
      // Zero-padded (ex.: '2026-09-05'), para bater EXATAMENTE com o
      // formato gerado por CheckinService.dateKey() no Dart — sem
      // isso a comparação de string nunca seria igual e nenhum
      // check-in passaria.
      function pad2(n) {
        return n < 10 ? '0' + n.toString() : n.toString();
      }

      function todayKey() {
        return request.time.toDate().year.toString() + '-' +
               pad2(request.time.toDate().month) + '-' +
               pad2(request.time.toDate().day);
      }

      // Check-in do dia atual: só aceita se lastCheckinDate ainda não
      // é hoje (trava contra check-in repetido no mesmo dia) e só
      // permite alterar exatamente os campos do check-in, com o XP
      // batendo com baseXp + o bônus do novo streak declarado.
      allow update: if isOwner(userId) &&
        resource.data.get('lastCheckinDate', '') != todayKey() &&
        request.resource.data.lastCheckinDate == todayKey() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'totalXp', 'level', 'lastActivity', 'lastCheckinDate',
            'checkinStreak', 'longestCheckinStreak', 'checkinFirstDate',
            'achievements'
          ]) &&
        request.resource.data.totalXp == resource.data.totalXp +
          checkinBaseXp() +
          checkinBonusForStreak(request.resource.data.checkinStreak);

      // ── Registro de cada dia (feito ou recuperado) ────────────────
      match /checkins/{dayId} {
        allow read: if isOwner(userId) || isAdmin();

        // Um doc por dia (o próprio ID já é a data) — criar de novo
        // um dia que já existe é sempre negado (isso é o que impede
        // recuperar/repetir o mesmo dia mais de uma vez).
        //
        // Usa getAfter() (não get()) no doc pai: o check-in de hoje
        // grava o novo checkinStreak no MESMO batch que cria este
        // documento, e get() dentro de uma regra enxerga o estado
        // ANTES da transação ser aplicada — pegaria sempre o streak
        // antigo. getAfter() lê o resultado já com essa escrita
        // simultânea aplicada, então o bônus é validado contra o
        // streak novo de verdade.
        allow create: if isOwner(userId) &&
          !exists(/databases/$(database)/documents/users_xp/$(userId)/checkins/$(dayId)) &&
          request.resource.data.status in ['done', 'recovered'] &&
          request.resource.data.xpAwarded == checkinBaseXp() +
            (request.resource.data.status == 'done'
              ? checkinBonusForStreak(
                  getAfter(/databases/$(database)/documents/users_xp/$(userId))
                    .data.get('checkinStreak', 0))
              : 0);

        allow update, delete: if isAdmin();
      }
    }