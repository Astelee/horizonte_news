<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- windowFullscreen removido: conflita com o edge-to-edge obrigatório
         a partir do Android 15 (ver comentário em values/styles.xml). -->
    <style name="LaunchTheme" parent="android:Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splashBackground</item>
    </style>

    <style name="NormalTheme" parent="android:Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>